# Save as .env.local in UTF-8 (not UTF-16). Project keys: sk-proj-...
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the vision model used by /api/analyze + /api/compare.
# Defaults to gpt-5.6-terra. Must be a vision-capable model; reasoning-tier
# models require the max_completion_tokens/reasoning_effort params the routes
# already send. (Moderation always uses omni-moderation-latest — not this var.)
# OPENAI_VISION_MODEL=gpt-5.6-terra

# Optional: dedicated secret for signing analysis-result tokens (falls back to
# OPENAI_API_KEY if unset). Set a random value in production if you rotate the
# OpenAI key often and don't want in-flight share tokens invalidated.
# RESULT_SIGNING_SECRET=

# Optional: combined global daily cap on /api/analyze + /api/compare calls
# (protects your OpenAI bill from rotating-IP abuse). Defaults to 500.
# DAILY_CALL_LIMIT=500

# Upstash Redis (rate limits, shared results, battles, leaderboard).
# Without these, rate limiting and all sharing/leaderboard features are disabled.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
